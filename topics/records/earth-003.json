  "claims": [
    {
      "id": "c1",
      "kind": "established_fact",
      "text": "The water cycle describes how Earth's water changes between liquid, solid and gas and moves on, above and in the Earth, and this is always happening everywhere.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c2",
      "kind": "established_fact",
      "text": "Evaporation turns liquid and frozen water into water vapor using the Sun's energy, and most of the water that evaporates comes from the oceans.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c3",
      "kind": "established_fact",
      "text": "As warm air carrying water vapor rises into the cold sky, the vapor condenses into tiny liquid droplets that form clouds.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c4",
      "kind": "established_fact",
      "text": "When cloud droplets combine into heavier drops it can rain, snow or hail, and where precipitation falls as snow it can stay on the ground for months and melt in spring.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c5",
      "kind": "established_fact",
      "text": "Most rain stays on the land surface and runs downhill into streams, rivers, lakes and the oceans, while some seeps into the ground to recharge groundwater.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c6",
      "kind": "mathematical_model",
      "text": "For any place, the change in stored water equals the water flowing in minus the water flowing out.",
      "source_ids": [],
      "equation_ids": [
        "e1"
      ]
    }
  ],
  "equations": [
    {
      "id": "e1",
      "name": "Water balance",
      "latex": "S = I - O",
      "dimension_check": {
        "lhs": "L",
        "rhs": "L"
      }
    }
  ],
  "assumptions": [
    "The Sun supplies the energy that drives evaporation.",
    "The water balance is for a natural place without human water use.",
    "Water changes between liquid, solid and gas."
  ],
  "variables": [
    {
      "symbol": "S",
      "name": "change in stored water",
      "unit": "L"
    },
    {
      "symbol": "I",
      "name": "water flowing in",
      "unit": "L"
    },
    {
      "symbol": "O",
