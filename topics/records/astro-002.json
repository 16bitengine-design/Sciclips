    }
  ],
  "claims": [
    {
      "id": "c1",
      "kind": "established_fact",
      "text": "Earth rotates on its axis once every 24 hours, and the Sun appears to move across the sky because Earth rotates.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c2",
      "kind": "established_fact",
      "text": "At all times half of Earth is lit by the Sun and half is in darkness; areas facing the Sun have daytime and areas facing away have nighttime.",
      "source_ids": [
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c3",
      "kind": "established_fact",
      "text": "If you shine a light on a globe and spin it, a place on the globe turns toward and away from the light, which makes day and night.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c4",
      "kind": "established_fact",
      "text": "At the equator Earth spins at about 2,200 kilometres per hour, which is just over 1,000 miles per hour, and people cannot feel this motion.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c5",
      "kind": "established_fact",
      "text": "The North Pole and South Pole have continuous daylight or darkness depending on the time of year.",
      "source_ids": [
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c6",
      "kind": "mathematical_model",
      "text": "Speed equals distance divided by time, so a spin of Earth's circumference in 24 hours gives the speed of the equator.",
      "source_ids": [],
      "equation_ids": [
        "e1"
      ]
    }
  ],
  "equations": [
    {
      "id": "e1",
      "name": "Speed from distance and time",
      "latex": "v = d / t",
      "dimension_check": {
        "lhs": "m s^-1",
        "rhs": "m s^-1"
      }
    }
  ],
  "assumptions": [
    "Earth spins steadily on its axis.",
    "The Sun lights half of Earth at any moment.",
    "Near the equator, day and night are about equal, and near the poles they depend on the season."
  ],
  "variables": [
    {
      "symbol": "v",
      "name": "speed of the equator's surface",
      "unit": "m s^-1"
    },
    {
      "symbol": "d",
      "name": "distance travelled in one spin",
      "unit": "m"
    },
    {
      "symbol": "t",
      "name": "time for one spin",
      "unit": "s"
    }
  ],
  "practical_applications": [
    "Setting a 24-hour clock and the length of a day.",
    "Planning when to be awake, work and sleep around daylight.",
    "Explaining why time zones exist."
  ],
  "misconceptions": [
    {
      "statement": "The Sun travels around Earth every day.",
      "correction": "The Sun only appears to move across the sky, because Earth rotates on its axis once every 24 hours."
    },
    {
      "statement": "We would feel Earth spinning, because it moves so fast.",
      "correction": "At the equator Earth moves at about 2,200 kilometres per hour, but the motion is steady, so people cannot feel it."
    }
  ],
  "what_if_scenarios": [
    {
      "title": "What if Earth stopped spinning?",
      "summary": "The same side would face the Sun all the time.",
      "correct": "Remember that half of Earth is always lit, and spinning moves each place through day and night.",
      "overlooked": "Assuming day and night would still alternate.",
      "what_changes": "Earth stops rotating on its axis.",
      "consequences": "The same half of Earth would stay lit, and places on it would have day without a break while the other half had constant night.",
      "why": "Day and night come from places turning toward and away from the Sun as Earth spins.",
      "prevention": "Remember that the spin is what changes day to night.",
      "claim_ids": [
        "c1",
        "c2"
      ]
    },
    {
      "title": "What if you stood at the North Pole?",
      "summary": "Day and night would not alternate every 24 hours.",
      "correct": "Expect continuous daylight or darkness depending on the time of year.",
      "overlooked": "Assuming every place has day and night every 24 hours.",
      "what_changes": "Your place is at the pole instead of a place nearer the equator.",
      "consequences": "The Sun would not rise and set each day, and the sky would stay light or dark depending on the time of year.",
      "why": "Near the poles the day and night pattern depends on the season.",
      "prevention": "Look up the day length for the place you are visiting.",
      "claim_ids": [
        "c2",
        "c5"
      ]
    }
  ],
