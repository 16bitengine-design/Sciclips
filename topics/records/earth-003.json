      "unit": "L"
    }
  ],
  "practical_applications": [
    "Understanding where rain, rivers and drinking water come from.",
    "Predicting floods from heavy rain and spring snowmelt.",
    "Explaining why the oceans do not run dry."
  ],
  "misconceptions": [
    {
      "statement": "There are rivers flowing under the ground.",
      "correction": "Water under the ground does move all the time, but it moves through spaces and cracks in the soil and rock, not in underground rivers."
    },
    {
      "statement": "Water on Earth gets used up.",
      "correction": "Earth's water keeps changing form and moving through the water cycle, so it is always moving and always everywhere."
    }
  ],
  "what_if_scenarios": [
    {
      "title": "What if the Sun's heat disappeared?",
      "summary": "Evaporation would stop working.",
      "correct": "Remember that the Sun's heat is what lets liquid water evaporate and moves the winds that carry clouds.",
      "overlooked": "Assuming the water cycle runs on its own.",
      "what_changes": "The Sun's energy is removed.",
      "consequences": "The main way water gets from the land and oceans back into the sky would stop working.",
      "why": "The Sun's heat breaks the bonds that hold liquid water together so it can become vapor.",
      "prevention": "Remember the Sun is what makes the water cycle work.",
      "claim_ids": [
        "c1",
        "c2"
      ]
    },
    {
      "title": "What if the precipitation falls as snow?",
      "summary": "Rivers rise months later, when the snow melts.",
      "correct": "Expect snow to wait on the ground and melt in spring.",
      "overlooked": "Assuming rivers rise right after it snows.",
      "what_changes": "Precipitation falls as snow instead of rain.",
      "consequences": "Snow builds up through the winter and can melt together in spring, so rivers rise later and floods are possible downstream.",
      "why": "Snow stays frozen until the weather warms up.",
      "prevention": "Watch the spring snowmelt in places with a lot of winter snow.",
      "claim_ids": [
        "c4",
        "c5"
      ]
    }
  ],
  "safety_considerations": {
