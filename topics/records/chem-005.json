  "practical_applications": [
    "Checking whether water in a stream or a pool is safe for life.",
    "Understanding why lemon juice tastes sour and soap feels slippery.",
    "Knowing why strong acids and bases need careful handling."
  ],
  "misconceptions": [
    {
      "statement": "Acids and bases are only found in laboratories.",
      "correction": "Many everyday things are acids or bases: vinegar and lemon juice are acidic, and laundry detergents and ammonia are basic."
    },
    {
      "statement": "A pH of 4 is only a little more acidic than a pH of 5.",
      "correction": "Each whole pH value is ten times stronger than the next, so a pH of 4 is ten times more acidic than a pH of 5."
    }
  ],
  "what_if_scenarios": [
    {
      "title": "What if you add lemon juice to pure water?",
      "summary": "The water becomes acidic.",
      "correct": "Expect the pH to fall below 7 as acid is added.",
      "overlooked": "Assuming pure water stays neutral after adding an acid.",
      "what_changes": "Lemon juice adds more free hydrogen ions.",
      "consequences": "The mixture is no longer neutral, and its pH drops below 7.",
      "why": "Water with more free hydrogen ions is acidic.",
      "prevention": "Check the pH after mixing liquids.",
      "claim_ids": [
        "c1",
        "c2",
        "c3"
      ]
    },
    {
      "title": "What if two liquids are three pH units apart?",
      "summary": "One is a thousand times more acidic than the other.",
      "correct": "Count ten times for every whole step on the scale.",
      "overlooked": "Assuming the difference is only three times.",
      "what_changes": "The pH values differ by three.",
      "consequences": "The more acidic liquid is 10 times 10 times 10, or 1,000 times, more acidic.",
      "why": "Each whole pH value is ten times stronger than the next.",
      "prevention": "Remember that pH is a logarithmic scale.",
      "claim_ids": [
        "c4"
      ]
    }
  ],
