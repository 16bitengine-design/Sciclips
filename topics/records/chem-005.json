  "claims": [
    {
      "id": "c1",
      "kind": "established_fact",
      "text": "pH measures how acidic or basic a water-based liquid is on a scale from 0 to 14, where 7 is neutral, a pH below 7 is acidic and a pH above 7 is basic.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c2",
      "kind": "established_fact",
      "text": "Water with more free hydrogen ions is acidic, and water with more free hydroxyl ions is basic.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c3",
      "kind": "established_fact",
      "text": "Pure water is neutral, with a pH of 7.0; vinegar and lemon juice are acidic, while laundry detergents and ammonia are basic.",
      "source_ids": [
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c4",
      "kind": "established_fact",
      "text": "Each whole pH value is ten times stronger than the next, so a pH of 4 is ten times more acidic than a pH of 5, and a mine drainage water five units below neutral is 100,000 times more acidic.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c5",
      "kind": "mathematical_model",
      "text": "The concentration of hydrogen ions equals the amount of hydrogen ions divided by the volume of the liquid.",
      "source_ids": [],
      "equation_ids": [
        "e1"
      ]
    }
  ],
  "equations": [
    {
      "id": "e1",
      "name": "Concentration of hydrogen ions",
      "latex": "c = n / V",
      "dimension_check": {
        "lhs": "mol L^-1",
        "rhs": "mol L^-1"
      }
    }
  ],
  "assumptions": [
