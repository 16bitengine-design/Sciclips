  "practical_applications": [
    "Understanding why sound can pass through walls and water.",
    "Explaining why space explosions would be silent.",
    "Understanding why astronomers study space with light and other waves, not with sound."
  ],
  "misconceptions": [
    {
      "statement": "Sound can travel through nothing at all.",
      "correction": "Sound is a vibration of matter, so it needs a medium such as air, water or a solid, and there is almost none in space."
    },
    {
      "statement": "Sound needs air in particular.",
      "correction": "Sound can travel through air, water and solids. What it needs is a medium made of matter."
    }
  ],
  "what_if_scenarios": [
    {
      "title": "What if you shouted in space?",
      "summary": "No one would hear you.",
      "correct": "Expect silence where there is nothing for the sound to vibrate through.",
      "overlooked": "Assuming sound travels through empty space.",
      "what_changes": "There is no air or other matter around you.",
      "consequences": "The vibrations have nothing to move through, so the sound does not travel to anyone's ears.",
      "why": "Sound waves need a medium to travel through.",
      "prevention": "Remember that sound needs matter, not only air.",
      "claim_ids": [
        "c1"
      ]
    },
    {
      "title": "What if there is a thick cloud of gas and dust?",
      "summary": "It could carry sound waves, but not ones we can hear.",
      "correct": "Expect a gas and dust cloud to carry sound waves of very low frequency.",
      "overlooked": "Assuming all of space is completely silent for every kind of wave.",
      "what_changes": "There is matter to carry the vibration.",
      "consequences": "Sound waves can travel in the cloud, but their frequency is so low that humans cannot hear them.",
      "why": "The particles are so spread out that the waves have a very low frequency.",
      "prevention": "Remember that human hearing has limits.",
      "claim_ids": [
        "c3",
        "c4"
      ]
    }
  ],
