  "practical_applications": [
    "Designing wings that give enough lift for the weight of an airplane.",
    "Understanding why gliders and paper airplanes fly.",
    "Seeing why pilots change the throttle or wing angle to speed up or slow down."
  ],
  "misconceptions": [
    {
      "statement": "The engines hold an airplane up.",
      "correction": "The wings make the lift. The engines supply thrust to overcome drag."
    },
    {
      "statement": "An airplane weighs the same during the whole flight.",
      "correction": "Weight changes as fuel is burned, although in cruise the change is small compared with the total weight."
    }
  ],
  "what_if_scenarios": [
    {
      "title": "What if an airplane had no engines?",
      "summary": "It could still fly as a glider.",
      "correct": "Remember that wings make the lift, and that a glider needs an outside source of power to start moving.",
      "overlooked": "Assuming engines hold the airplane up.",
      "what_changes": "The thrust from engines is removed.",
      "consequences": "A glider can still fly for long distances, but something must give it the first push, such as a tow aloft.",
      "why": "Lift comes from the wings moving through the air, not from the engines.",
      "prevention": "Remember that engines fight drag and wings make the lift.",
      "claim_ids": [
        "c2",
        "c4"
      ]
    },
    {
      "title": "What if the pilot adds more thrust?",
      "summary": "Thrust becomes larger than drag, so the airplane speeds up.",
      "correct": "Expect unbalanced forces to accelerate the aircraft in the direction of the larger force.",
      "overlooked": "Assuming the speed stays the same when the engines change.",
      "what_changes": "Thrust increases while drag is still the same.",
      "consequences": "The forces become unbalanced, so the airplane accelerates forward.",
      "why": "Unbalanced forces give an acceleration, as Newton's laws say.",
      "prevention": "Remember that cruise needs thrust to equal drag.",
      "claim_ids": [
        "c3",
        "c6"
      ]
    }
  ],
