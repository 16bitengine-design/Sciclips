      "title": "What Are the Moon's Phases?",
      "publisher": "NASA Space Place (Jet Propulsion Laboratory)",
      "url": "https://spaceplace.nasa.gov/moon-phases/en/",
      "date_published": null,
      "date_updated": "2023-06-12",
      "date_accessed": "2026-11-19",
      "kind": "agency_web_page"
    },
    {
      "id": "s2",
      "title": "Earth's Moon",
      "publisher": "NASA Science",
      "url": "https://science.nasa.gov/moon/",
      "date_published": "2023-03-27",
      "date_updated": "2026-10-14",
      "date_accessed": "2026-11-19",
      "kind": "agency_web_page"
    }
  ],
  "claims": [
    {
      "id": "c1",
      "kind": "established_fact",
      "text": "The Moon does not produce its own light, and moonlight is sunlight reflecting off the Moon's surface.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c2",
      "kind": "established_fact",
      "text": "The shape of the Moon does not change; the Sun always lights the half of the Moon that faces it, and how much of that lit half we see from Earth changes as the Moon orbits Earth.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c3",
      "kind": "established_fact",
      "text": "The Moon shows eight phases in order: new, waxing crescent, first quarter, waxing gibbous, full, waning gibbous, third quarter and waning crescent.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c4",
      "kind": "established_fact",
      "text": "During a new moon the side of the Moon facing Earth is dark, and during a full moon we see the whole illuminated side.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c5",
      "kind": "established_fact",
      "text": "It takes the Moon about 27.3 days to orbit Earth, but about 29.5 days to go from one new moon to the next.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c6",
      "kind": "mathematical_model",
      "text": "The time from one new moon to the next is about 2.2 days longer than one orbit of the Moon, 29.5 days compared with 27.3 days.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": [
        "e1"
      ]
    }
  ],
  "equations": [
    {
      "id": "e1",
      "name": "Extra time from one new moon to the next",
      "latex": "D = S - O",
      "dimension_check": {
        "lhs": "s",
        "rhs": "s"
      }
    }
  ],
  "assumptions": [
    "The Moon is viewed from Earth.",
    "Lunar eclipses are not included.",
    "The Sun always lights the half of the Moon that faces it."
  ],
  "variables": [
    {
      "symbol": "D",
      "name": "extra time compared with one orbit",
      "unit": "s"
    },
    {
      "symbol": "S",
      "name": "time from one new moon to the next",
      "unit": "s"
    },
    {
      "symbol": "O",
      "name": "time for one orbit of the Moon",
      "unit": "s"
    }
  ],
  "practical_applications": [
    "Telling roughly what time of the month it is from the Moon's shape.",
    "Planning when the night sky will be darker or brighter for stargazing.",
    "Understanding why a month on a lunar calendar is about 29.5 days long."
  ],
  "misconceptions": [
    {
      "statement": "The Moon makes its own light.",
      "correction": "The Moon does not produce its own light. Moonlight is sunlight that reflects off the Moon's surface."
    },
    {
      "statement": "The Moon really changes shape during the month.",
      "correction": "The shape of the Moon does not change. Our view of the lit half of the Moon changes as the Moon orbits Earth."
    }
  ],
  "what_if_scenarios": [
    {
      "title": "What if the Moon made its own light?",
      "summary": "It would shine fully all month, but the Moon only reflects sunlight.",
      "correct": "Remember that moonlight is sunlight reflecting off the Moon, and that the Sun lights only the half facing it.",
      "overlooked": "Assuming the Moon glows on its own.",
      "what_changes": "We imagine a light source on the Moon itself.",
      "consequences": "We would expect the whole face to shine all month, but we see crescents, half moons and a dark new moon.",
      "why": "The Moon does not produce its own light, and the Sun lights only the half facing it.",
      "prevention": "Ask where the light comes from before explaining what we see.",
      "claim_ids": [
        "c1",
        "c2"
      ]
    },
    {
      "title": "What if the Moon is between Earth and the Sun?",
      "summary": "We see the dark side, so we cannot see the Moon.",
      "correct": "Expect a new moon: the side of the Moon facing Earth is dark.",
      "overlooked": "Assuming the Moon has vanished.",
      "what_changes": "The lit half of the Moon faces away from Earth.",
      "consequences": "The side facing Earth is dark, so the Moon cannot be seen even though it is still there.",
      "why": "The Sun lights the side of the Moon that faces the Sun, which at new moon is the far side.",
      "prevention": "Check where the Moon is in its orbit before saying it has gone.",
      "claim_ids": [
        "c2",
        "c4"
      ]
    }
  ],
  "safety_considerations": {
    "risk_level": "low",
    "hazards": [
