  ],
  "practical_applications": [
    "Floating ice keeps lakes and oceans from freezing solid from the bottom up.",
    "White polar ice floats and reflects sunlight that would otherwise warm the planet.",
    "Explaining why ice stays on top in a cold drink."
  ],
  "misconceptions": [
    {
      "statement": "Ice floats because it is lighter in weight.",
      "correction": "A big block of ice can be heavy. It floats because it is less dense than liquid water, which means it has less mass for the space it takes up."
    },
    {
      "statement": "Water molecules pack closer together when water freezes.",
      "correction": "In ice the molecules lock into an ordered, hexagonal structure that is more spaced out than in liquid water."
    }
  ],
  "what_if_scenarios": [
    {
      "title": "What if ice sank?",
      "summary": "Lakes and oceans could freeze from the bottom up.",
      "correct": "Remember that ice floats, so freezing starts at the top and liquid water can stay below.",
      "overlooked": "Assuming ice would sink like most solids.",
      "what_changes": "Ice becomes denser than liquid water.",
      "consequences": "Ponds, lakes and oceans would freeze from the bottom up, harming the living things in them.",
      "why": "Floating ice stays on top, so the water below is not frozen solid.",
      "prevention": "Remember that water is unusual: its solid is less dense than its liquid.",
      "claim_ids": [
        "c1",
        "c5"
      ]
    },
    {
      "title": "What if water behaved like argon?",
      "summary": "Ice cubes would sink.",
      "correct": "Remember that water is an exception because of its hydrogen bonds.",
      "overlooked": "Assuming every solid is denser than its liquid.",
      "what_changes": "Water would lose the open, hydrogen-bonded structure of ice.",
      "consequences": "Ice cubes would drop to the bottom of the glass, as solid argon does in liquid argon.",
      "why": "Most other substances sink as solids, but the hydrogen bonds in water hold ice in an open structure.",
      "prevention": "Check how a substance bonds before predicting if its solid floats.",
      "claim_ids": [
        "c1",
        "c4"
      ]
    }
  ],
