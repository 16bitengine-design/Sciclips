{
  "provider": "zernio",
  "secret_names": {
    "api_key": "ZERNIO_API_KEY",
    "youtube_account_id": "ZERNIO_YOUTUBE_ACCOUNT_ID",
    "tiktok_account_id": "ZERNIO_TIKTOK_ACCOUNT_ID"
  },
  "test_publishing_enabled": false,
  "platforms": {
    "youtube_short": { "enabled": true, "format": "short" },
    "youtube_long": { "enabled": true, "format": "long" },
    "tiktok": { "enabled": true, "format": "short" }
  },
  "default_schedule_delay_hours": 24,
  "use_idempotency_keys": true,
  "max_retries": 2,
  "never_log_credentials": true
}
