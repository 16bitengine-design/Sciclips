      "kind": "agency_web_page"
    }
  ],
  "claims": [
    {
      "id": "c1",
      "kind": "established_fact",
      "text": "Four forces act on an airplane in flight: weight pulls toward the center of the Earth, lift is generated by the motion of the airplane through the air and acts perpendicular to the flight direction, drag opposes the motion, and thrust from the engines overcomes drag.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c2",
      "kind": "established_fact",
      "text": "Most of the lift is generated by the wings, and the job of the engines is to overcome drag, not to lift the airplane.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c3",
      "kind": "established_fact",
      "text": "If the forces on an aircraft are balanced it cruises at constant velocity, and if they are unbalanced it accelerates in the direction of the largest force.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c4",
      "kind": "established_fact",
      "text": "Gliders have no engines and fly well, because their wings make the lift, but some outside source of power is needed to start the motion.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c5",
      "kind": "law",
      "text": "By Newton's first law of motion, an object in motion keeps a constant velocity unless a net external force acts on it.",
      "source_ids": [
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c6",
      "kind": "mathematical_model",
      "text": "In cruise, lift equals weight and thrust equals drag, so there is no net external force on the aircraft.",
      "source_ids": [
        "s2"
      ],
      "equation_ids": [
        "e1",
        "e2"
      ]
    }
  ],
  "equations": [
    {
      "id": "e1",
      "name": "Lift balances weight in cruise",
      "latex": "L = W",
      "dimension_check": {
        "lhs": "N",
        "rhs": "N"
      }
    },
    {
      "id": "e2",
      "name": "Thrust balances drag in cruise",
      "latex": "T = D",
      "dimension_check": {
        "lhs": "N",
        "rhs": "N"
      }
    }
  ],
  "assumptions": [
    "The airplane is in steady, level cruising flight.",
    "The change in weight from burning fuel is small.",
    "Forces are balanced, so there is no net external force."
  ],
  "variables": [
