      "title": "Rainbows (Water and Light)",
      "publisher": "USGS Water Science School",
      "url": "https://www.usgs.gov/water-science-school/science/rainbows-water-and-light",
      "date_published": null,
      "date_updated": null,
      "date_accessed": "2026-11-19",
      "kind": "agency_web_page"
    }
  ],
  "claims": [
    {
      "id": "c1",
      "kind": "established_fact",
      "text": "A rainbow forms when sunlight enters a water droplet, slowing down and bending as it goes from air to denser water, reflects off the inside of the droplet and separates into its colours, and the colours leave the drop to make the rainbow.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c2",
      "kind": "established_fact",
      "text": "Violet, the shortest visible wavelength, bends the most inside the droplet, and red, the longest, bends the least, so the light is separated into all its colours.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c3",
      "kind": "established_fact",
      "text": "To see a rainbow, water droplets must be in the air, the Sun must be behind the viewer, and the clouds must have cleared away from the Sun; a rainbow does not exist in a particular place but appears when the Sun, the droplets and the viewer's position are right.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c4",
      "kind": "established_fact",
      "text": "The primary rainbow comes from one reflection inside the droplet, while the fainter secondary rainbow comes from two reflections, with its red light leaving at about 50 degrees instead of 42 degrees and its colours in reverse order.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c5",
      "kind": "established_fact",
      "text": "A full rainbow is a complete circle, but from the ground only part of it is seen; from an airplane in the right conditions a whole circular rainbow can be seen.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c6",
      "kind": "mathematical_model",
      "text": "For a light wave, the speed equals the frequency times the wavelength, so light with a shorter wavelength has a higher frequency.",
      "source_ids": [],
      "equation_ids": [
        "e1"
      ]
    }
  ],
  "equations": [
    {
      "id": "e1",
      "name": "Wave speed from frequency and wavelength",
      "latex": "c = f L",
      "dimension_check": {
        "lhs": "m s^-1",
        "rhs": "s^-1 m"
      }
    }
  ],
  "assumptions": [
    "Sunlight contains all the visible colours.",
    "The raindrops are roughly spherical and the Sun is behind the viewer.",
    "Each colour is bent by a slightly different amount."
  ],
  "variables": [
    {
      "symbol": "c",
      "name": "speed of the light wave",
      "unit": "m s^-1"
    },
    {
      "symbol": "f",
      "name": "frequency of the light",
      "unit": "s^-1"
    },
    {
      "symbol": "L",
      "name": "wavelength of the light",
      "unit": "m"
    }
  ],
  "practical_applications": [
    "Understanding how prisms and lenses split light.",
    "Finding where to look for a rainbow when it rains and the Sun is out.",
    "Explaining why a double rainbow has its colours in reverse order."
  ],
  "misconceptions": [
    {
      "statement": "A rainbow is an object in the sky that you could walk up to.",
      "correction": "A rainbow does not exist in a particular place. It appears only when the Sun, the droplets and the viewer's position are just right."
    },
    {
      "statement": "A rainbow is only an arch.",
      "correction": "A full rainbow is a complete circle. From the ground we see only part of it."
    }
  ],
  "what_if_scenarios": [
    {
      "title": "What if the Sun is in front of you instead of behind you?",
      "summary": "You would not see a rainbow.",
      "correct": "Remember that the Sun must be behind the viewer, with the droplets in front.",
      "overlooked": "Assuming a rainbow can be seen in any direction.",
      "what_changes": "The Sun is on the same side as the raindrops you are looking at.",
      "consequences": "The light that makes the rainbow is not sent back toward your eyes, so you do not see one.",
      "why": "A rainbow appears only when the Sun is behind the viewer and the droplets are in front.",
      "prevention": "Turn your back to the Sun and look at the rain.",
      "claim_ids": [
        "c1",
        "c3"
      ]
    },
    {
      "title": "What if the light reflects twice inside the drops?",
      "summary": "A second, fainter rainbow appears above the first.",
      "correct": "Expect a secondary rainbow with its colours in reverse order, red below.",
      "overlooked": "Assuming there can only be one rainbow.",
      "what_changes": "The sunlight reflects a second time inside each water droplet.",
      "consequences": "A fainter secondary rainbow appears above the primary one, with red on the bottom and violet on the top.",
      "why": "The light leaves the drop at a different angle, about 50 degrees instead of 42 degrees for red.",
      "prevention": "Look above the main rainbow for a fainter second one.",
      "claim_ids": [
        "c4"
      ]
    }
  ],
  "safety_considerations": {
    "risk_level": "low",
    "hazards": [
      "Looking straight at the Sun",
      "Wet slippery ground"
    ],
    "safety_equipment": [
      "Never look at the Sun directly",
      "Use a glass prism or a garden hose with the Sun behind you to make a safe rainbow"
    ],
    "supervision_required": true
  },
  "short_video_potential": {
    "suitable": true,
    "angle": "Raindrops bend, bounce and spread sunlight into its colours."
  },
  "long_video_potential": {
    "suitable": true,
    "angle": "Refraction, reflection, primary and secondary rainbows, and why a rainbow is really a circle."
  },
