  "claims": [
    {
      "id": "c1",
      "kind": "established_fact",
      "text": "Sound waves need a medium, matter such as air, water or a solid, to travel through, and the vacuum of deep space, where there is little or no matter, has nothing for the vibrations to move through, so sound does not travel there.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c2",
      "kind": "established_fact",
      "text": "Sound can travel directly through a solid, such as a table, to reach your ears.",
      "source_ids": [
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c3",
      "kind": "established_fact",
      "text": "Space is not completely empty: large areas of gas and dust have the potential to carry sound waves.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c4",
      "kind": "established_fact",
      "text": "The particles in space are so spread out that the sound waves they carry have a very low frequency, too low for humans to hear.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c5",
      "kind": "mathematical_model",
      "text": "For a sound wave, the speed equals the frequency times the wavelength.",
      "source_ids": [],
      "equation_ids": [
        "e1"
      ]
    }
  ],
  "equations": [
