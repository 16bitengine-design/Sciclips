      "symbol": "m",
      "name": "mass of dissolved salt",
      "unit": "kg"
    },
    {
      "symbol": "V",
      "name": "volume of water",
      "unit": "m^3"
    }
  ],
  "practical_applications": [
    "Understanding why sea water cannot be drunk.",
    "Explaining why some lakes with no outlet become salty.",
    "Understanding how ocean chemistry is shaped by rocks and vents."
  ],
  "misconceptions": [
    {
      "statement": "Rivers have no salt in them at all.",
      "correction": "Rivers carry some dissolved salts, but rain keeps their water fresh, and they flow into the ocean, which collects the salt and minerals from all of them."
    },
    {
      "statement": "The ocean has always been as salty as it is now.",
      "correction": "The primeval seas were probably only slightly salty. The ocean became saltier over time as rain broke up rocks and carried their minerals to the sea."
    }
  ],
  "what_if_scenarios": [
    {
      "title": "What if there were no hydrothermal vents?",
      "summary": "The ocean would still get salts from rivers.",
      "correct": "Remember that salts come from two sources: runoff from the land and vents in the seafloor.",
      "overlooked": "Assuming all the salt comes from rivers.",
      "what_changes": "The vents in the seafloor are removed.",
      "consequences": "The ocean would still collect the salts that rivers carry, but it would lose one of its two sources of minerals.",
      "why": "Salt in the ocean comes from runoff from the land and from openings in the seafloor.",
      "prevention": "Count both sources when you explain the salt.",
      "claim_ids": [
        "c1",
        "c4"
      ]
    },
    {
      "title": "What if the ocean could remove every dissolved ion?",
      "summary": "The ocean would not get saltier over time.",
      "correct": "Expect salts to build up only when ions are not removed from the water.",
      "overlooked": "Assuming all the dissolved ions build up in the same way.",
      "what_changes": "Ocean life and other processes remove all the ions that arrive.",
      "consequences": "The salt concentration would stop rising, instead of building up as it does now.",
      "why": "Some ions are used by ocean life, but others are not removed, so their concentrations increase.",
      "prevention": "Ask which ions are removed and which are not.",
      "claim_ids": [
        "c5"
      ]
    }
  ],
