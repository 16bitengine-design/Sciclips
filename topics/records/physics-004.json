  "claims": [
    {
      "id": "c1",
      "kind": "established_fact",
      "text": "Dividing the seconds between seeing lightning and hearing thunder by five gives the distance to the strike in miles, or by three in kilometres.",
      "source_ids": [
        "s1",
        "s3"
      ],
      "equation_ids": []
    },
    {
      "id": "c2",
      "kind": "established_fact",
      "text": "Thunder is the shock wave produced when lightning heats the surrounding air so quickly that it expands explosively.",
      "source_ids": [
        "s2",
        "s3"
      ],
      "equation_ids": []
    },
    {
      "id": "c3",
      "kind": "established_fact",
      "text": "Lightning can heat the air around its channel to about 30,000 degrees Celsius in a fraction of a second.",
      "source_ids": [
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c4",
      "kind": "established_fact",
      "text": "Sound travels roughly one mile every five seconds and moves faster in warm air than in cool air, and thunder can normally be heard up to about 10 miles away.",
      "source_ids": [
        "s2",
        "s3"
      ],
      "equation_ids": []
    },
    {
      "id": "c5",
      "kind": "established_fact",
      "text": "Lightning can strike beyond the range where thunder can be heard, so if you hear thunder the storm is close enough for lightning to strike where you are.",
      "source_ids": [
        "s3"
      ],
      "equation_ids": []
    },
    {
      "id": "c6",
      "kind": "mathematical_model",
      "text": "The delay between flash and thunder equals the distance divided by the speed of sound, so distance equals speed times time.",
      "source_ids": [],
      "equation_ids": [
        "e1"
      ]
    }
  ],
  "equations": [
    {
      "id": "e1",
      "name": "Distance from speed and time",
      "latex": "d = v t",
      "dimension_check": {
        "lhs": "m",
        "rhs": "m s^-1 s"
      }
    }
  ],
  "assumptions": [
    "The light from the flash reaches you almost instantly.",
    "The speed of sound stays about the same along the path.",
    "The strike is within the range where thunder can be heard."
  ],
  "variables": [
    {
      "symbol": "d",
      "name": "distance to the lightning strike",
      "unit": "m"
    },
    {
      "symbol": "v",
      "name": "speed of sound in air",
      "unit": "m s^-1"
    },
    {
      "symbol": "t",
      "name": "delay between flash and thunder",
      "unit": "s"
    }
  ],
  "practical_applications": [
    "Estimating how far away a storm is.",
    "Judging when a storm is close enough that it is time to go indoors.",
    "Telling if a storm is coming closer by watching if the delay gets shorter."
  ],
  "misconceptions": [
    {
      "statement": "Thunder and lightning are two separate events.",
      "correction": "Thunder is the sound that lightning makes. Both start at the same moment and in the same place."
    },
    {
      "statement": "If it is not raining where you are, lightning cannot reach you.",
      "correction": "Lightning can strike well away from the rain. If you can hear thunder, it is time to go indoors."
    }
  ],
  "what_if_scenarios": [
    {
      "title": "What if the air is warmer than usual?",
      "summary": "Sound moves a little faster, so the delay is a little shorter.",
      "correct": "Treat the divide-by-five rule as a good estimate, because the speed of sound changes with air temperature.",
      "overlooked": "Assuming that sound always travels at exactly the same speed.",
      "what_changes": "The air temperature changes, and so does the speed of sound.",
      "consequences": "For the same distance the delay is a little different, so the count gives an estimate and not an exact measurement.",
      "why": "Sound moves faster in warm air than in cool air.",
      "prevention": "Use the count as a good estimate and round the distance.",
      "claim_ids": [
        "c1",
        "c4"
      ]
    },
    {
      "title": "What if you can see lightning but cannot hear thunder?",
      "summary": "No thunder does not mean no danger.",
      "correct": "Remember that lightning can strike beyond the range where thunder can be heard.",
      "overlooked": "Assuming that no thunder means a storm is harmless.",
      "what_changes": "The strike is too far away for its sound to reach you.",
      "consequences": "You see the flash but hear nothing, even though the storm is real and can still be dangerous.",
      "why": "Thunder can normally be heard only up to about 10 miles, but lightning can strike beyond that range.",
      "prevention": "When a storm is in the area, plan to go indoors early and do not wait for thunder.",
      "claim_ids": [
        "c4",
        "c5"
      ]
    }
  ],
