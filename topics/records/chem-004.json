  "claims": [
    {
      "id": "c1",
      "kind": "established_fact",
      "text": "Rocks on land are the major source of the salts in seawater: rainwater is slightly acidic, so it erodes rocks and carries salts and minerals as dissolved ions to streams, rivers and the ocean.",
      "source_ids": [
        "s1",
        "s3"
      ],
      "equation_ids": []
    },
    {
      "id": "c2",
      "kind": "established_fact",
      "text": "Rivers do not taste salty because rain keeps replenishing their fresh water, but the ocean collects the salt and minerals from all the rivers that flow into it.",
      "source_ids": [
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c3",
      "kind": "established_fact",
      "text": "Rivers carry an estimated four billion tons of dissolved salts to the ocean every year.",
      "source_ids": [
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c4",
      "kind": "established_fact",
      "text": "Hydrothermal vents in the seafloor are another source of salts: seawater seeps into the rocks of the oceanic crust, is heated, dissolves minerals and flows back out into the ocean.",
      "source_ids": [
        "s1",
        "s3"
      ],
      "equation_ids": []
    },
    {
      "id": "c5",
      "kind": "established_fact",
      "text": "Some dissolved ions are used by ocean life, but others are not removed, so their concentrations increase over time.",
      "source_ids": [
        "s1",
        "s3"
      ],
      "equation_ids": []
    },
    {
      "id": "c6",
      "kind": "mathematical_model",
      "text": "The concentration of dissolved salt equals the mass of salt divided by the volume of water.",
      "source_ids": [],
      "equation_ids": [
        "e1"
      ]
    }
  ],
  "equations": [
    {
      "id": "e1",
      "name": "Concentration of dissolved salt",
      "latex": "c = m / V",
      "dimension_check": {
        "lhs": "kg m^-3",
        "rhs": "kg m^-3"
      }
    }
  ],
  "assumptions": [
    "Rain keeps freshwater flowing in rivers.",
    "The ocean collects the salts that rivers and vents add.",
    "Concentration depends on the mass of salt and the volume of water."
  ],
  "variables": [
    {
      "symbol": "c",
      "name": "concentration of salt",
      "unit": "kg m^-3"
    },
