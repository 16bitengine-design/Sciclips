  ],
  "claims": [
    {
      "id": "c1",
      "kind": "established_fact",
      "text": "Ice is less dense than liquid water, which is unusual, because solid argon would sink in liquid argon and so would the solids of most other substances.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c2",
      "kind": "established_fact",
      "text": "Each water molecule is one oxygen atom bonded to two hydrogen atoms, and water molecules attract each other through hydrogen bonds.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c3",
      "kind": "established_fact",
      "text": "In liquid water hydrogen bonds constantly form and break, but below about 4 degrees Celsius the energy of the molecules falls below the energy of the hydrogen bonds, so bonds form much more often than they break.",
      "source_ids": [
        "s1"
      ],
      "equation_ids": []
    },
    {
      "id": "c4",
      "kind": "established_fact",
      "text": "In ice, hydrogen bonds hold the molecules in an ordered, hexagonal structure that is more spaced out and less dense than liquid water, and an object that is less dense than the fluid it is in floats.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c5",
      "kind": "established_fact",
      "text": "If ice sank, lakes and oceans would freeze from the bottom up, harming the living things in them.",
      "source_ids": [
        "s1",
        "s2"
      ],
      "equation_ids": []
    },
    {
      "id": "c6",
      "kind": "mathematical_model",
      "text": "Density is mass divided by volume, so ice, which has the same mass in a larger volume than liquid water, has a lower density.",
      "source_ids": [],
      "equation_ids": [
        "e1"
      ]
    }
  ],
  "equations": [
    {
      "id": "e1",
      "name": "Density definition",
      "latex": "rho = m / V",
      "dimension_check": {
        "lhs": "kg m^-3",
        "rhs": "kg m^-3"
      }
    }
  ],
  "assumptions": [
    "Water at normal pressure near its freezing point.",
    "The mass of the water stays the same when it freezes.",
    "An object floats if it is less dense than the fluid it is in."
  ],
  "variables": [
    {
      "symbol": "rho",
      "name": "density",
      "unit": "kg m^-3"
    },
